{
  inputs = {
    : for $config -> $item {
    nixpkgs-systemd-<: $item.version :> = {
    :   if $item.mode == "flake" {
      url = "github:NixOS/nixpkgs/<: $item.commit :>";
    :   } else {
      url = "https://github.com/NixOS/nixpkgs/archive/<: $item.commit :>.tar.gz";
      flake = false;
    :   }
    };
    : }
  };

  outputs = {
      self,
      : for $config -> $item {
      nixpkgs-systemd-<: $item.version :>,
      : }
      ...
  } : {
    : for $config -> $item {
    :   if $item.mode == 'flake' {
    nixosConfigurations.systemd-<: $item.version :> = nixpkgs-systemd-<: $item.version :>.lib.nixosSystem {
      system = "x86_64-linux";
      modules = [
        ./cfg/systemd-<: $item.version :>/configuration.nix
        # This only sets ‹-Dtpm2=false›, but we also need to set ‹-Dtpm=false›.
        # See ‹configuration.nix› for the overlay setting.
        # {
        #   systemd.package = nixpkgs-systemd-<: $item.version :>.legacyPackages.x86_64-linux.systemd.override {
        #     withTpm2Tss = false;
        #   };
        # }
      ];
    };
    :   } else {
    :      die("Unsupported input mode");
    :   }
    : }
  };
}
