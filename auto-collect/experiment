#!/bin/sh

# ‹experiment› -- Manage overall workflow of capturing TPMSpy data
#
# 	experiment [-h] [-q] [N]
#
# This script calls other scripts in this directory to collect data:
#
#  1. Get available flakes from the VM (see ‹flakes›).
#  2. Build configurations for these flakes (see ‹setup›).
#  3. For each flake:
#     ◦ Switch to the configuration (see ‹switch›).
#     ◦ Collect ‹$N› datapoints (see ‹collect›).
#  4. Convert all ‹tpmspy.bin› to ‹tpmspy.json› (see ‹convert›).
#
# If ‹N› is not specified, ‹$cfg_default_captures› is used instead.
#
# By default, ‹tput bel› is executed at the end of the script, which causes
# the terminal bell. Use ‹-q› to run quietly.

script_path=$(readlink -f "$0")
script_bin=$(dirname "${script_path}")
script_name=$(basename "${script_path}")

if [ -n "$COLLECT_CONFIG" ]; then
	echo "export COLLECT_CONFIG=$COLLECT_CONFIG"
	export COLLECT_CONFIG
fi

. "$script_bin/common"


usage() {
	echo "usage: ${script_name} [-n]"
}

cmd() {
	printf "\033[93mVM\$\033[0m \033[1m%s\033[0m\n" "$*"
	if ! "$@"; then
		printf "\033[93m ×  \033[0m \033[1m%s\033[0m\n" "$*"
		exit 1
	fi
}

opt_new=
while getopts "hn" option; do
	case "${option}" in
	h)
		usage
		exit 0
		;;
	n)
		opt_new=1
		;;
	*)
		usage >&2
		exit 1
	esac
done

shift $((OPTIND - 1))

if [ "$#" -gt 1 ]; then
	usage >&2
	exit 1
fi

count="${1:-$cfg_default_captures}"
traces_dst="${cfg_traces_dst}"

printf "\x1b[96m ** \x1b[0m \x1b[1m%s\x1b[0m\n" "Setting up flakes"
flakes=$("$script_bin"/flakes -k)

"$script_bin/setup" -k $flakes

for flake in $flakes; do
	printf "\x1b[33m ~> \x1b[0m Switch \x1b[1m%s\x1b[0m\n" "$flake"
	cmd "$script_bin/switch" "$flake"

	printf "\x1b[33m |> \x1b[0m Collect \x1b[1m%s\x1b[0m\n" "$flake"
	cmd "$script_bin/collect" -o "$traces_dst" "$flake" "$count"

	printf "\x1b[33m ~> \x1b[0m Revert to \x1b[1mdefault\x1b[0m profile\n"
	cmd "$script_bin/restore"
done

printf "\x1b[33m ** \x1b[0m Switch \x1b[1m%s\x1b[0m\n" "Convert TPMSpy traces"
cmd "$script_bin/convert" "$traces_dst"

[ "$opt_bel" -eq 1 ] && tput bel
